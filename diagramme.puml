  usecase "Prendre rendez-vous" as UC3
  usecase "Consulter dossier médical" as UC4
  usecase "Voir tableau de bord" as UC5

  usecase "Gérer les consultations" as UC6
  usecase "Utiliser outils IA" as UC7
  usecase "Détection Mélanome" as UC7a
  usecase "Classification Acné" as UC7b
  usecase "Score GAGS" as UC7c
  usecase "Triage Lésions" as UC7d
  usecase "Prescrire ordonnance" as UC8
  usecase "Gérer dossier patient" as UC9

  usecase "Triage des patients" as UC10
  usecase "Enregistrer signes vitaux" as UC11

  usecase "Gérer rendez-vous" as UC12
  usecase "Enregistrer patient" as UC13

  usecase "Gérer utilisateurs" as UC14
  usecase "Voir statistiques" as UC15
  usecase "Gérer alertes" as UC16
  usecase "Générer rapports" as UC17
}

Patient --> UC1
Patient --> UC2
Patient --> UC3
Patient --> UC4
Patient --> UC5

Medecin --> UC2
